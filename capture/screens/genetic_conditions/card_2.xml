 password="false" selected="false" bounds="[142,1862][425,1927]" drawing-order="0" hint="" /><node index="8" text="" resource-id="" class="android.view.View" package="com.szalongevity.sza_mobile" content-desc="Dilated cardiomyopathy, a disease characterized by the heart's main pumping chamber becoming weakened and enlarged, has various risk factors that contribute to its development. Genetic predisposition plays a significant role, with certain genetic mutations and familial history increasing the likelihood of developing dilated cardiomyopathy. Additionally, long-standing high blood pressure can cause the heart to work harder, potentially leading to the weakening and enlargement of the heart muscle. Similarly, inflammatory diseases, such as viral infections or autoimmune disorders, can cause inflammation in the heart muscle and contribute to its weakening. Certain toxins, like alcohol and chemotherapy drugs, can also damage the heart muscle and lead to its enlargement. Moreover, diseases that affect the heart's electrical system, such as myocarditis or long QT syndrome, can increase the risk of developing dilated cardiomyopathy. Lastly, factors such as age, obesity, and diabetes can exacerbate the risk of developing dilated cardiomyopathy, particularly in individuals with other underlying risk factors." checkable="false" checked="false" clickable="false" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[142,2011][1138,2564]" drawing-order="0" hint="" /></node></node><node index="2" text="" resource-id="" class="android.view.View" package="com.szalongevity.sza_mobile" content-desc="MONITOR CLOSELY&#10;Aneurysm-osteoarthritis syndrome&#10;GENE:&#10;SMAD3&#10;VARIANT:&#10;NM_005902.4:c.533-13_533-10del&#10;INHERITANCE:&#10;Autosomal dominant" checkable="false" checked="false" clickable="false" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" pass